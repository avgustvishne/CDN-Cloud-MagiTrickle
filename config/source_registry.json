{
  "cloud-ip-ranges": {
    "base": "https://raw.githubusercontent.com/disposable/cloud-ip-ranges/master/txt",
    "files": {
      "aws": "aws.txt",
      "cloudflare": "cloudflare.txt",
      "hetzner": "hetzner.txt",
      "ovh": "ovh.txt",
      "akamai": "akamai.txt",
      "digitalocean": "digitalocean.txt",
      "microsoft": "microsoft-azure.txt",
      "oracle": "oracle.txt",
      "alibaba": "alibaba.txt",
      "fastly": "fastly.txt",
      "gcore": "gcore-cdn.txt",
      "scaleway": "scaleway.txt",
      "backblaze": "backblaze.txt",
      "github": "github.txt",
      "google": "google-cloud.txt",
      "linode": "linode.txt",
      "flyio": "flyio.txt",
      "bunny": "bunny.txt",
      "apple_private_relay": "apple-private-relay.txt",
      "gitlab": "gitlab.txt",
      "openai": "openai.txt",
      "vercel": "vercel.txt"
    }
  },
  "cloud-egress-ip-ranges": {
    "url": "https://github.com/ipanalytics/Cloud-Egress-IP-Ranges/releases/latest/download/cloud-egress-ip-ranges.json",
    "provider_field": "provider",
    "cidr_field": "cidr",
    "providers": [
      "aws",
      "google",
      "azure",
      "oracle",
      "cloudflare",
      "fastly",
      "github",
      "gitlab"
    ]
  },
  "cdn-ip-database": {
    "base": "https://raw.githubusercontent.com/mansourjabin/cdn-ip-database/main/data",
    "resolved_ipv4": "resolved_ips.json",
    "resolved_text": "cdn.lst",
    "sources_catalog": "sources.json",
    "refresh": "daily",
    "role": "official-source-catalog-and-cross-check"
  },
  "mrkhachaturov-ipranges": {
    "base": "https://raw.githubusercontent.com/mrkhachaturov/ipranges/main",
    "refresh": "4h",
    "role": "independent-public-source-cross-check",
    "merged_pattern": "{provider}/ipv4_merged.txt",
    "ipv6_merged_pattern": "{provider}/ipv6_merged.txt"
  },
  "asn-index": {
    "release": "https://github.com/remnawave/asn-index/releases/latest/download/asn-prefixes.json",
    "refresh": "daily",
    "role": "ASN-to-prefix-index",
    "upstream": "ipverse/as-ip-blocks"
  },
  "routesentinel": {
    "repo": "https://github.com/ipanalytics/RouteSentinel",
    "role": "BGP-route-origin-and-RPKI-validation-reference",
    "refresh": "daily",
    "policy": "validation-only-not-primary-provider-source"
  },
  "asn-threat-feeds": {
    "base": "https://dfratiani.github.io/asn-threat-feeds",
    "refresh": "automated",
    "role": "BGP-announced-ASN-cross-check",
    "patterns": {
      "ipv4": "as{asn}_ipv4.txt",
      "ipv6": "as{asn}_ipv6.txt",
      "all": "as{asn}_all.txt"
    }
  },
  "cloud-provider-ip-addresses": {
    "repo": "https://github.com/rezmoss/cloud-provider-ip-addresses",
    "refresh": "daily",
    "role": "independent-provider-cross-check",
    "policy": "not-authoritative; never overrides official feeds"
  },
  "projectdiscovery-cdncheck": {
    "repo": "https://github.com/projectdiscovery/cdncheck",
    "provider_registry": "cmd/generate-index/provider.yaml",
    "role": "provider-identity-and-cidr-cross-check",
    "refresh": "on-update",
    "authority": "secondary"
  },
  "taythebot-cdn-ranges": {
    "repo": "https://github.com/taythebot/cdn-ranges",
    "role": "independent-cdn-cidr-cross-check",
    "refresh": "on-update",
    "authority": "secondary"
  },
  "krainium-cdn-fetcher": {
    "repo": "https://github.com/Krainium/cdn-fetcher",
    "role": "official-live-provider-fetcher-reference",
    "refresh": "on-update",
    "authority": "high-for-supported-providers"
  },
  "ipverse-as-ip-blocks": {
    "base": "https://raw.githubusercontent.com/ipverse/as-ip-blocks/master/as",
    "refresh": "daily",
    "role": "independent-BGP-ASN-prefix-source",
    "formats": [
      "ipv4-aggregated.txt",
      "ipv6-aggregated.txt"
    ],
    "authority": "secondary",
    "license": "CC0-1.0",
    "notes": "Daily BGP-derived aggregated prefixes per ASN; additive cross-check only."
  },
  "caida-bgpstream": {
    "repo": "https://github.com/CAIDA/bgpstream",
    "live_projects": [
      "routeviews-stream",
      "ris-live"
    ],
    "role": "independent-real-time-BGP-validation",
    "refresh": "continuous",
    "authority": "validation",
    "notes": "Used as an independent live-BGP validation layer; generator does not depend on a single live stream."
  }
}
